{
    "Project": {
        "Project-GlobalOptions": {
            "name": "qt_$(env:PACKAGE)_qtwaylandcompositor_$(env:TESTED_MODULE_BRANCH_COIN)_$(env:TARGET_OS_COIN)"
        },
        "BuildSystemIntegration": {
            "child_order": [
                "GCCSetup",
                "CMake",
                "LinkLibraries"
            ]
        },
        "CMake": {
            "_active": true,
            "_copy_from": "CMakeIntegration",
            "build_environment": {},
            "build_options": "-j4",
            "generate_options": "--fresh",
            "generator": "Ninja"
        },
        "GCCSetup": {
            "_active": true,
            "_copy_from": "Command",
            "build_command": "gccsetup --cc gcc --cxx g++ --config ../../../axivion/"
        },
        "LinkLibraries": {
            "_active": true,
            "_copy_from": "AxivionLinker",
            "input_files": [
                "build/lib/libQt6WaylandCompositor.so.*.ir"
            ],
            "ir": "$(env:IRNAME)",
            "plugin_files": [
                "build/qml/QtWayland/Compositor/*.so"
            ]
        }
    },
    "_Format": "1.0",
    "_Version": "7.6.2",
    "_VersionNum": [
        7,
        6,
        2,
        12725
    ]
}
